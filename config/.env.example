# tAPIbot — Environment Variables
# Copy to config/.env and fill in real values

# Exchange selection: binance | kraken
EXCHANGE=binance

# API credentials (get from exchange developer portal)
BINANCE_API_KEY=
BINANCE_API_SECRET=

KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Trading pair
TRADE_SYMBOL=BTC/USDT

# Safety limits
READONLY=true                # set to false to place real orders
MIN_PROFIT_USD=5.0           # minimum USD profit per signal to execute
MAX_TRADE_VOLUME_BTC=0.005   # maximum BTC per arb leg

# Signal polling
POLL_INTERVAL_SECONDS=10
MODE=listen                  # listen | dry-run

# Tanulytics integration
# Path to the signal log written by Tanulytics crypto_arb_fetch.py
# SIGNAL_LOG=/path/to/Tanulytics/data/arb_signals.jsonl

LOG_LEVEL=INFO
